# --- App URL (production: your canonical origin; optional in dev — browser origin is used client-side) ---
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Supabase (browser + server SSR) ---
# Project URL only (no /rest/v1 suffix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy JWT anon key (Dashboard → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: new publishable key (if you have migrated off legacy anon)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase service role (server-only, never NEXT_PUBLIC_) ---
# Bypasses RLS — use only in Route Handlers, Server Actions, or internal jobs.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Cron / internal hooks (server-only) ---
# Used by POST /api/cron/trip-reminders, /api/cron/return-reminders, /api/cron/outbound-dispatch (Authorization: Bearer <secret>)
# CRON_SECRET=

# --- Resend (transactional email; optional — without RESEND_API_KEY, outbound jobs are not enqueued) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM="Oxour Go <onboarding@resend.dev>"
# OPS_ALERT_EMAILS=ops@yourdomain.com,lead@yourdomain.com

# --- WhatsApp (optional override for wa.me deep links; defaults from lib/constants BUSINESS_WHATSAPP_URL) ---
# NEXT_PUBLIC_WHATSAPP_BUSINESS_E164=912200000000

# --- WhatsApp Cloud API (server-only — webhook + future outbound; optional until provider is wired) ---
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

# --- Optional: allow /supabase-test on non-local production hosts (staging only). Never set on public prod.
# ENABLE_SUPABASE_DIAGNOSTIC_ROUTE=1

# --- Sentry (optional in local dev; set in staging/production) ---
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
# NEXT_PUBLIC_SENTRY_RELEASE=oxour-go@1.0.0
# Optional: 0–1 performance trace sampling (defaults: dev 1, prod ~0.12 server / client)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload (CI only; never commit the token)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=  # optional override when not on Vercel

# --- Razorpay (optional — online checkout stays off until keys + PAYMENTS_ONLINE_CHECKOUT_ENABLED=1) ---
# Server-only secret — never NEXT_PUBLIC_
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=whsec_...
# Publishable key for future client Checkout.js (optional if RAZORPAY_KEY_ID is set server-side)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
# Explicitly enable live checkout (still uses stub provider until Razorpay SDK is wired)
# PAYMENTS_ONLINE_CHECKOUT_ENABLED=0
# NEXT_PUBLIC_PAYMENTS_ONLINE_CHECKOUT_ENABLED=0

# --- PostHog (optional; disabled without key) ---
# Project API key from PostHog project settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Ingestion host (EU: https://eu.i.posthog.com)
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional label for property `analytics_environment`
# NEXT_PUBLIC_POSTHOG_ENVIRONMENT=production
# Local/dev: analytics stay off unless you set:
# NEXT_PUBLIC_POSTHOG_ENABLE_DEV=1
# Hard-disable even when a key is present (e.g. local debugging against prod key):
# NEXT_PUBLIC_POSTHOG_DISABLED=1

# --- Launch control center (optional — shown on /admin/launch environment cards) ---
# LAUNCH_PRODUCTION_URL=https://your-domain.com
# LAUNCH_STAGING_URL=https://staging.your-domain.com
