# --- App URL (production: your canonical origin; optional in dev — browser origin is used client-side) ---
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Supabase (browser + server SSR) ---
# Project URL only (no /rest/v1 suffix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy JWT anon key (Dashboard → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: new publishable key (if you have migrated off legacy anon)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase service role (server-only, never NEXT_PUBLIC_) ---
# Bypasses RLS — use only in Route Handlers, Server Actions, or internal jobs.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Cron / internal hooks (server-only) ---
# Used by POST /api/cron/trip-reminders (Authorization: Bearer <secret>)
# CRON_SECRET=

# --- Optional: allow /supabase-test on non-local production hosts (staging only). Never set on public prod.
# ENABLE_SUPABASE_DIAGNOSTIC_ROUTE=1

# --- Sentry (optional in local dev; set in staging/production) ---
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
# NEXT_PUBLIC_SENTRY_RELEASE=oxour-go@1.0.0
# Optional: 0–1 performance trace sampling (defaults: dev 1, prod ~0.12 server / client)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload (CI only; never commit the token)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=  # optional override when not on Vercel

# --- PostHog (optional; disabled without key) ---
# Project API key from PostHog project settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Ingestion host (EU: https://eu.i.posthog.com)
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional label for property `analytics_environment`
# NEXT_PUBLIC_POSTHOG_ENVIRONMENT=production
# Local/dev: analytics stay off unless you set:
# NEXT_PUBLIC_POSTHOG_ENABLE_DEV=1
# Hard-disable even when a key is present (e.g. local debugging against prod key):
# NEXT_PUBLIC_POSTHOG_DISABLED=1
